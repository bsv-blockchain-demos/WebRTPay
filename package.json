{
  "name": "@bsv/webrtpay",
  "version": "0.1.0",
  "description": "Direct wallet-to-wallet BSV payments over WebRTC data channels, authenticated with BRC-100 identity keys",
  "type": "module",
  "sideEffects": false,
  "license": "SEE LICENSE IN LICENSE.txt",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "webrtpay-relay": "dist/server/cli.js"
  },
  "files": [
    "dist",
    "docs/protocol.md",
    "README.md",
    "LICENSE.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:turn": "RUN_TURN_TESTS=1 node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "format:check": "prettier --check --no-error-on-unmatched-pattern src server test examples"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "@bsv/sdk": "^2.8.6 || ^3.0.0"
  },
  "devDependencies": {
    "@bsv/sdk": "2.8.11",
    "@jest/globals": "^30",
    "@types/jest": "^30",
    "@types/node": "^22",
    "@types/ws": "^8.18",
    "fast-check": "^4",
    "jest": "^30",
    "node-datachannel": "0.33.4",
    "prettier": "^3",
    "ts-jest": "^29",
    "typescript": "^5.9"
  }
}
